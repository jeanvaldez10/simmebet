 * Referral System    *
 * ********************
 */

model UserReferral {
  id           String   @id @default(uuid())
  userId       String   @unique // The user who was referred
  referredBy   String // Username or code of referrer
  referredById String // User ID of referrer
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user     User @relation("UserReferralRecord", fields: [userId], references: [id], onDelete: Cascade)
  referrer User @relation("ReferredByUser", fields: [referredById], references: [id], onDelete: Cascade)

  @@index([referredById])
  @@index([referredBy])
  @@map("user_referrals")
}

model ReferralStats {
  id                  String   @id @default(uuid())
  userId              String   @unique
  totalReferrals      Int      @default(0)
  activeReferrals     Int      @default(0)
  layer1Volume        Decimal  @default(0) @db.Decimal(18, 2)
  layer2Volume        Decimal  @default(0) @db.Decimal(18, 2)
  layer1Points        Decimal  @default(0) @db.Decimal(18, 2)
  layer2Points        Decimal  @default(0) @db.Decimal(18, 2)
  totalReferralPoints Decimal  @default(0) @db.Decimal(18, 2)
  lastCalculated      DateTime @default(now()) @map("last_calculated")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referral_stats")
}
